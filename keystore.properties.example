# Copy this file to the ignored keystore.properties and replace every value.
# An absolute path is recommended so the release key never lives in Git.
storeFile=C:/Users/your-name/.openksenax/signing/openksenax-release-v1.p12
storePassword=replace-with-a-strong-secret
keyAlias=openksenax-release-v1
keyPassword=replace-with-a-strong-secret
